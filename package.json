{
    "name": "cnb-dev-extension",
    "displayName": "CNB.COOL",
    "description": "用来在VSCode/Cursor中创建并连接CNB.COOL的云开发环境",
    "version": "0.0.9",
    "repository": {
        "type": "git",
        "url": "https://cnb.cool/xiaofei/cnb-vscode-plugin.git"
    },
    "publisher": "lixiaofei",
    "icon": "resources/icon.png",
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [],
    "main": "./out/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "cnb-dev",
                    "title": "Cloud Development",
                    "icon": "resources/icon.svg"
                }
            ]
        },
        "views": {
            "cnb-dev": [
                {
                    "id": "cnbDev.environmentView",
                    "name": "CNB.COOL",
                    "type": "webview"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/glob": "^7.1.3",
        "@types/mocha": "^8.2.2",
        "@types/node": "14.x",
        "@types/vscode": "^1.60.0",
        "@typescript-eslint/eslint-plugin": "^4.26.0",
        "@typescript-eslint/parser": "^4.26.0",
        "eslint": "^7.27.0",
        "glob": "^7.1.7",
        "mocha": "^8.4.0",
        "typescript": "^4.3.2",
        "vscode-test": "^1.5.2"
    },
    "dependencies": {
        "axios": "^1.6.7"
    }
}